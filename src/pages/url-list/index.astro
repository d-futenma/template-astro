---
interface StaticPathItem {
  params: Record<string, string | undefined>;
  props?: Record<string, unknown>;
}

interface PageModule {
  url?: string;
  getStaticPaths?: () => Promise<StaticPathItem[]>;
}

interface Page extends PageModule {
  file: string;
}

interface PathItem {
  file: string;
  url: string;
  label: string;
}

const pageModules = import.meta.glob<PageModule>('/src/pages/**/*.astro', { eager: true });
const allPages: Page[] = Object.entries(pageModules).map(([file, mod]) => ({
  file,
  ...mod,
}));

const pathList: PathItem[] = [];

const changeExtension = (filename: string): string => {
  return filename.replace(/\.astro$/, '.html');
};

const extractRoutePath = (fullPath: string): string => {
  return fullPath.split('/src/pages/')[1] ?? '';
};

const normalizeSlashes = (value: string): string => {
  return value.replace(/\/+/g, '/');
};

const trimSlashes = (value: string): string => {
  return value.replace(/^\/+|\/+$/g, '');
};

const toUrl = (routePath: string): string => {
  const normalized = trimSlashes(routePath);

  if (normalized === '' || normalized === 'index.html') {
    return '/';
  }

  if (normalized.endsWith('/index.html')) {
    return `/${normalized.slice(0, -'/index.html'.length)}/`;
  }

  if (normalized.endsWith('.html')) {
    return `/${normalized}`;
  }

  return `/${normalized}/`;
};

const toLabel = (routePath: string): string => {
  const normalized = trimSlashes(routePath);

  if (normalized === '' || normalized === 'index.html') {
    return 'index.html';
  }

  if (normalized.endsWith('.html')) {
    return normalized;
  }

  return `${normalized}/index.html`;
};

const buildDynamicRoutePath = (
  file: string,
  params: Record<string, string | undefined>,
): string => {
  let routePath = extractRoutePath(file).replace(/\.astro$/, '');

  for (const [key, value] of Object.entries(params)) {
    const safeValue = value ?? '';

    routePath = routePath.replace(`[...${key}]`, safeValue);
    routePath = routePath.replace(`[${key}]`, safeValue);
  }

  routePath = normalizeSlashes(routePath);

  if (routePath === 'index') {
    return 'index.html';
  }

  if (routePath.endsWith('/index')) {
    return `${routePath}.html`;
  }

  return changeExtension(routePath);
};

const buildStaticRoutePath = (file: string): string => {
  return changeExtension(extractRoutePath(file));
};

const generateUrl = async (page: Page): Promise<void> => {
  if (page.getStaticPaths) {
    const paths = await page.getStaticPaths();

    paths.forEach((item) => {
      const routePath = buildDynamicRoutePath(page.file, item.params);

      pathList.push({
        file: page.file,
        url: toUrl(routePath),
        label: toLabel(routePath),
      });
    });

    return;
  }

  const routePath = buildStaticRoutePath(page.file);

  pathList.push({
    file: page.file,
    url: toUrl(routePath),
    label: toLabel(routePath),
  });
};

await Promise.all(allPages.map(generateUrl));
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>URL LIST</title>
    <style is:inline>
      html {
        font-size: 62.5% !important;
      }
      .page-url-list {
        background-color: #f5f5f5;
        color: #333;
        font-family: Helvetica Neue, Arial, Hiragino Kaku Gothic ProN, Hiragino Sans, Meiryo, sans-serif;
        font-weight: 400;
        padding: 6.666666666666667vw;
      }
      @media only screen and (min-width: 769px) {
        .page-url-list {
          padding: 50px;
        }
      }
      .url-list-content {
        margin-inline: auto;
      }
      @media only screen and (min-width: 769px) {
        .url-list-content {
          max-width: 960px;
        }
      }
      .url-list-heading {
        line-height: 1;
        font-size: 4vw;
        font-weight: 700;
        margin-bottom: 3.333333333333333vw;
        text-align: center;
      }
      @media only screen and (min-width: 769px) {
        .url-list-heading {
          font-size: 2rem;
          margin-bottom: 20px;
        }
      }
      .url-list {
        border: 1px solid #d7d7d7;
        border-radius: 10px;
        overflow: hidden;
      }
      .url-list-item {
        font-size: 4vw;
        background: #fafafb;
        word-break: break-all;
      }
      .url-list-item:not(:first-child) {
        border-top: 1px solid #d7d7d7;
      }
      .url-list-item:nth-child(odd) {
        background: #fff;
      }
      @media only screen and (min-width: 769px) {
        .url-list-item {
          line-height: 1;
          font-size: 1.6rem;
        }
      }
      .url-list-link {
        color: #333;
        display: block;
        height: 100%;
        padding: 2.666666666666667vw;
      }
      @media only screen and (min-width: 769px) {
        .url-list-link {
          padding: 15px;
        }
      }
      .url-list-label {
        display: block;
        padding-left: 1.4em;
        position: relative;
      }
      @media only screen and (min-width: 769px) {
        .url-list-label {
          padding-left: 2em;
        }
      }
      .url-list-label:before {
        position: absolute;
        top: 0.4vw;
        left: 0;
        content: '📱';
        display: block;
      }
      @media only screen and (min-width: 769px) {
        .url-list-label:before {
          content: '🖥️';
          top: 1px;
        }
      }
    </style>
  </head>
  <body class="page-url-list">
    <div class="url-list-content">
      <h1 class="url-list-heading">URL LIST</h1>
      <ul class="url-list">
        {pathList.map((item) => (
          <li class="url-list-item"><a class="url-list-link" href={item.url}><span class="url-list-label">{item.label}</span></a></li>
        ))}
      </ul>
    </div>
  </body>
</html>